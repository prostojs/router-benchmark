{
  "name": "complex-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:router": "pnpm --filter router-benchmark start",
    "bench:router:scale": "pnpm --filter router-benchmark scale",
    "bench:wooks": "pnpm --filter wooks-benchmark start",
    "bench:wooks:dev": "pnpm --filter wooks-benchmark dev",
    "bench:moost": "pnpm --filter moost-benchmark start -- 1",
    "bench:all": "pnpm bench:router && pnpm bench:wooks && pnpm bench:moost"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prostojs/router-benchmark.git"
  },
  "author": "Artem Maltsev",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prostojs/dye",
      "esbuild"
    ]
  }
}
