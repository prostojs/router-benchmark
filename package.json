{
  "name": "complex-benchmark",
  "private": true,
  "type": "module",
  "scripts": {
    "bench:router": "pnpm --filter router-benchmark start",
    "bench:router:scale": "pnpm --filter router-benchmark scale",
    "bench:wooks": "pnpm --filter wooks-benchmark start",
    "bench:wooks:db": "pnpm --filter wooks-benchmark start:db",
    "bench:moost": "pnpm --filter moost-benchmark start",
    "bench:moost:db": "pnpm --filter moost-benchmark start:db",
    "bench:validator": "pnpm --filter validator-benchmark start",
    "bench:all": "pnpm bench:router && pnpm bench:router:scale && pnpm bench:wooks && pnpm bench:moost",
    "smoke": "pnpm --filter router-benchmark start --quick && pnpm --filter router-benchmark scale --quick && pnpm --filter wooks-benchmark quick && pnpm --filter moost-benchmark quick && pnpm --filter validator-benchmark quick"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prostojs/router-benchmark.git"
  },
  "author": "Artem Maltsev",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core"
    ],
    "overrides": {
      "express": "5.3.0",
      "fastify": "5.12.7"
    }
  }
}
